# repository-root config: sqlfluff ignores `templater` set in a subdirectory
# config (see platform/dbt/.sqlfluff, owned by P04). CI runs
# `sqlfluff lint platform/dbt/...` from the repo root so relative paths
# (data/warehouse.duckdb) resolve. Rule set mirrors platform/dbt/.sqlfluff.
[sqlfluff]
dialect = duckdb
templater = dbt
rules = LT01,CP01,CP02,AL01,AM04
max_line_length = 120

[sqlfluff:templater:dbt]
apply_dbt_builtins = True
project_dir = platform/dbt
profiles_dir = platform/dbt

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit
