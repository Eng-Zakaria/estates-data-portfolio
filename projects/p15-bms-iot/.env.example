# P15 BMS stack credentials. Copy to `.env` and change every value.
# The defaults in this file and in docker-compose.yml are DEMO ONLY.

# MQTT broker (mosquitto). Password file must match: see README "Regenerating
# the MQTT password file".
MQTT_USERNAME=bms_user
MQTT_PASSWORD=DEMO_ONLY_change_me
MQTT_PORT=1883
MQTT_WS_PORT=9001

# TimescaleDB
POSTGRES_USER=bms_user
POSTGRES_PASSWORD=DEMO_ONLY_change_me
POSTGRES_DB=bms_db
POSTGRES_PORT=5433

# Node-RED editor
NODERED_PASSWORD=DEMO_ONLY_change_me
NODERED_PORT=1880

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=DEMO_ONLY_change_me
GRAFANA_PORT=3000
