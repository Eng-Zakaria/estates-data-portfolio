# P02 Airflow stack env. Copied to .env by `make airflow-build` (gitignored).
# Values here are DEMO ONLY defaults for the portfolio stack.
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_UID=50000
# Keep the default "." so ${AIRFLOW_PROJ_DIR:-.}/dags stays a dot-prefixed
# (bind) path; project directory is set via --project-directory in the Makefile.
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
# DEMO ONLY password. Change for any non-local use.
_AIRFLOW_WWW_USER_PASSWORD=airflow-DEMO_ONLY_change_me
_AIRFLOW_WWW_USER_FIRSTNAME=Estates
_AIRFLOW_WWW_USER_LASTNAME=Ops
_AIRFLOW_WWW_USER_EMAIL=estates-ops@example.org
_PIP_ADDITIONAL_REQUIREMENTS=
